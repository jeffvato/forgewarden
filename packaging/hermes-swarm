#!/usr/bin/env bash
set -euo pipefail

RUNTIME_ROOT="${HERMES_SWARM_RUNTIME_ROOT:-/home/jeff/hermes-swarm-runtime}"
AUDIT_ROOT="${HERMES_SWARM_AUDIT_ROOT:-/home/jeff/hermes-swarm-audit}"
PYTHON="${HERMES_SWARM_PYTHON:-python3}"
BASELINE_REPOSITORY="${HERMES_SWARM_BASELINE_REPOSITORY:-/home/jeff/swarm-repositories/n8n-csv-baseline-v2}"

resolve_swarm_root() {
  local script_dir candidate
  script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
  candidate="$(CDPATH= cd -- "$script_dir/.." && pwd -P)"
  if test -f "$candidate/swarm/__init__.py" && test -d "$candidate/config" && test -d "$candidate/schemas"; then
    printf '%s\n' "$candidate"
    return 0
  fi
  echo "hermes-swarm: launcher is not inside a valid swarm checkout" >&2
  return 1
}

SWARM_ROOT="$(resolve_swarm_root)"

if ! command -v "$PYTHON" >/dev/null 2>&1 && ! test -x "$PYTHON"; then
  echo "hermes-swarm: configured Python executable is unavailable" >&2
  exit 1
fi

for configured_path in "$RUNTIME_ROOT" "$AUDIT_ROOT" "$BASELINE_REPOSITORY"; do
  case "$configured_path" in
    /*) ;;
    *) echo "hermes-swarm: configured paths must be absolute: $configured_path" >&2; exit 1 ;;
  esac
done

usage() {
  cat <<'EOF'
Usage: hermes-swarm {start|status|workflow-status|prompt|enable-dry-run|dry-run|quality-review|quality-apply-safe|quality-audit|review-evidence|approval-create|approval-verify|approval-reconcile|controlled-baseline|audit|stop|kill-switch}

Parallel local-only Hermes coding swarm. Deployment is permanently disabled.
EOF
}

ensure_runtime() {
  test -f "$RUNTIME_ROOT/agents/hermes.md"
  test -f "$RUNTIME_ROOT/config/policy.yaml"
  test -f "$RUNTIME_ROOT/review/task.md"
}

case "${1:-status}" in
  start)
    ensure_runtime
    mkdir -p "$RUNTIME_ROOT/state"
    touch "$RUNTIME_ROOT/RUNNING"
    touch "$RUNTIME_ROOT/KILL_SWITCH"
    echo "started: DRY_RUN only; kill switch engaged; deployment disabled"
    ;;
  status)
    ensure_runtime
    if test -f "$RUNTIME_ROOT/KILL_SWITCH"; then kill_state=ENGAGED; else kill_state=CLEARED_FOR_DRY_RUN; fi
    echo "launcher=hermes-swarm mode=DRY_RUN deployment=DISABLED kill_switch=$kill_state runtime=$RUNTIME_ROOT"
    ;;
  workflow-status)
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli workflow-status --runtime-root "$RUNTIME_ROOT"
    ;;
  prompt)
    ensure_runtime
    cat <<EOF
You are Hermes.

Use this agent profile as your operating instructions:

$(sed -n '1,260p' "$RUNTIME_ROOT/agents/hermes.md")

Follow this sandbox policy exactly:

$(sed -n '1,260p' "$RUNTIME_ROOT/config/policy.yaml")

Current task:

$(sed -n '1,260p' "$RUNTIME_ROOT/review/task.md")

Session rules:
- Stay inside $RUNTIME_ROOT and the disposable fixture allowlist.
- Deployment is disabled. Codex is the only writer; agy/Gemini is read-only.
EOF
    ;;
  enable-dry-run)
    ensure_runtime
    rm -f "$RUNTIME_ROOT/KILL_SWITCH"
    echo "dry-run enabled; deployment remains disabled"
    ;;
  dry-run)
    ensure_runtime
    test ! -f "$RUNTIME_ROOT/KILL_SWITCH" || { echo "blocked: dry-run kill switch engaged" >&2; exit 1; }
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli dry-run --runtime-root "$RUNTIME_ROOT" --state-dir "$RUNTIME_ROOT/state" --audit-dir "$AUDIT_ROOT"
    ;;
  quality-review)
    shift
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli quality-review "$@"
    ;;
  quality-apply-safe)
    shift
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli quality-apply-safe "$@"
    ;;
  quality-audit)
    shift
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli quality-audit "$@"
    ;;
  review-evidence)
    shift
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli review-evidence "$@"
    ;;
  approval-create)
    shift
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli approval-create "$@"
    ;;
  approval-verify)
    shift
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli approval-verify "$@"
    ;;
  approval-reconcile)
    shift
    exec env PYTHONPATH="$SWARM_ROOT" "$PYTHON" -m swarm.cli approval-reconcile "$@"
    ;;
  controlled-baseline)
    ensure_runtime
    test -f "$RUNTIME_ROOT/KILL_SWITCH" || { echo "blocked: controlled baseline requires engaged kill switch" >&2; exit 1; }
    exec env PYTHONPATH="$SWARM_ROOT" HERMES_SWARM_RUNTIME_ROOT="$RUNTIME_ROOT" HERMES_SWARM_AUDIT_ROOT="$AUDIT_ROOT" "$PYTHON" -m swarm.cli controlled-baseline --repository "$BASELINE_REPOSITORY" --runtime-root "$RUNTIME_ROOT" --state-dir "$RUNTIME_ROOT/state" --audit-dir "$AUDIT_ROOT"
    ;;
  audit)
    found=0
    while IFS= read -r audit_file; do
      found=1
      echo "===== $audit_file"
      sed -n '1,260p' "$audit_file"
    done < <(find "$AUDIT_ROOT" -maxdepth 1 -type f -name audit.jsonl -print 2>/dev/null)
    test "$found" -eq 1 || echo "no audit record"
    ;;
  stop|kill-switch)
    mkdir -p "$RUNTIME_ROOT/state"
    touch "$RUNTIME_ROOT/KILL_SWITCH"
    echo "kill switch engaged; no production service stopped"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
