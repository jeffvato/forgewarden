{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SafeApplicationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "state",
    "repository",
    "applied_finding_ids",
    "changed_files",
    "before_sha256",
    "after_sha256",
    "verification",
    "rollback_performed",
    "committed",
    "pushed"
  ],
  "properties": {
    "mode": { "const": "SAFE_ONLY_ISOLATED_WORKTREE" },
    "state": { "enum": ["APPLIED_VERIFIED", "ROLLED_BACK_VERIFICATION_FAILED"] },
    "repository": { "type": "string", "minLength": 1 },
    "applied_finding_ids": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" } },
    "changed_files": { "type": "array", "items": { "type": "string", "pattern": "^(?!/).+" } },
    "before_sha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "after_sha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "passed", "exit_code"],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "passed": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] }
      }
    },
    "rollback_performed": { "type": "boolean" },
    "committed": { "const": false },
    "pushed": { "const": false }
  }
}
