{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgewarden.org/schemas/addon-manifest.schema.json",
  "title": "Forgewarden Add-on Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "name", "version", "publisher", "description", "entrypoint", "capabilities", "permissions", "signature"],
  "properties": {
    "manifest_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "min_forgewarden_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entrypoint": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,239}$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"enum": ["ui.panel", "task.plan", "evidence.read"]}},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "network", "shell", "git", "production"],
      "properties": {
        "read": {"type": "array", "uniqueItems": true, "items": {"enum": ["job_status", "redacted_evidence", "model_profiles"]}},
        "network": {"const": false},
        "shell": {"const": false},
        "git": {"const": false},
        "production": {"const": false}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "manifest_sha256"],
      "properties": {
        "algorithm": {"const": "sha256-signature-v1"},
        "key_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{3,120}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
