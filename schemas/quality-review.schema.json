{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "repository",
    "generated_at",
    "source_files_scanned",
    "source_files_read",
    "source_symlinks_skipped",
    "sensitive_source_files_skipped",
    "detector_coverage",
    "findings",
    "counts",
    "consolidation",
    "application_policy",
    "auto_apply_enabled"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "mode": { "const": "READ_ONLY" },
    "repository": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_files_scanned": { "type": "integer", "minimum": 0 },
    "source_files_read": { "type": "integer", "minimum": 0 },
    "source_symlinks_skipped": { "type": "integer", "minimum": 0 },
    "sensitive_source_files_skipped": { "type": "integer", "minimum": 0 },
    "detector_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "extensions", "mode", "detectors"],
        "properties": {
          "language": { "type": "string", "minLength": 1 },
          "extensions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
          },
          "mode": { "enum": ["SYNTAX_AWARE", "TEXT_ONLY"] },
          "detectors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "auto_apply_enabled": { "const": false },
    "application_policy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "tier", "decision", "mutation_allowed"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "tier": { "enum": ["SAFE", "CAREFUL", "RISKY"] },
          "decision": {
            "enum": ["SAFE_REVIEW_ONLY", "TEST_VERIFICATION_REQUIRED", "HUMAN_REVIEW_REQUIRED"]
          },
          "mutation_allowed": { "const": false }
        }
      }
    },
    "consolidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duplicate_findings_removed",
        "application_order",
        "tier_order",
        "review_required"
      ],
      "properties": {
        "duplicate_findings_removed": { "type": "integer", "minimum": 0 },
        "application_order": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        },
        "tier_order": {
          "const": ["SAFE", "CAREFUL", "RISKY"]
        },
        "review_required": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SAFE", "CAREFUL", "RISKY"],
      "properties": {
        "SAFE": { "type": "integer", "minimum": 0 },
        "CAREFUL": { "type": "integer", "minimum": 0 },
        "RISKY": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "tier",
          "confidence",
          "file",
          "line",
          "symbol",
          "duplicate_count",
          "summary",
          "evidence",
          "rationale",
          "suggested_action",
          "auto_apply"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "category": {
            "type": "string",
            "enum": [
              "ai_slop",
              "concurrency_risk",
              "duplicate_logic",
              "leaky_abstraction",
              "n_plus_one_query",
              "naming_rot",
              "nested_ternary",
              "parse_failure",
              "pass_through_wrapper",
              "silent_failure",
              "stale_state",
              "structural_bloat",
              "unreadable_source",
              "unbounded_growth",
              "unreachable_code",
              "unused_import"
            ]
          },
          "tier": { "enum": ["SAFE", "CAREFUL", "RISKY"] },
          "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "file": { "type": "string", "pattern": "^(?!/).+" },
          "line": { "type": "integer", "minimum": 1 },
          "symbol": { "type": ["string", "null"] },
          "duplicate_count": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
          "evidence": { "type": "string", "maxLength": 512 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "suggested_action": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "auto_apply": { "const": false }
        }
      }
    }
  }
}
