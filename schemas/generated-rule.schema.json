{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeneratedRepositoryRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "scope", "trigger", "rule", "enforcement", "evidence", "source_job_id", "confidence", "category", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "scope": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "maxLength": 240},
    "rule": {"type": "string", "maxLength": 240},
    "enforcement": {"type": ["string", "null"]},
    "evidence": {"type": "string"},
    "source_job_id": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "category": {"enum": ["VALIDATION", "TESTING", "STYLE", "COMPATIBILITY", "SECURITY", "DATA", "DEPLOYMENT", "GOVERNANCE"]},
    "status": {"enum": ["PROPOSED", "ACTIVE", "DISABLED", "RETIRED"]}
  }
}
